rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /citas/{citaId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /clientes/{clienteId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /expedientes/{expedienteId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /cobros/{cobroId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /reportes/{reporteId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantes;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participantes;
    }

    match /calificaciones/{calificacionId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /facturas/{facturaId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /notificaciones/{notificacionId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /abogados/{abogadoId} {
      allow read, write: if request.auth != null && request.auth.uid == abogadoId;
    }

    match /empresas/{empresaId} {
      allow read: if request.auth != null && resource.data.abogadoId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.abogadoId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.abogadoId == request.auth.uid;
    }

    match /registros/{registroId} {
      allow read, write: if request.auth != null;
    }
  }
}
